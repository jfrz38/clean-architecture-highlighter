{
  "name": "@jfrz38/eslint-plugin-clean-architecture-highlighter",
  "version": "0.1.0",
  "description": "ESLint plugin for Clean Architecture dependency boundary checks.",
  "author": "José F. Ruiz <jrz899@inlumine.ual.es>",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "./out/src/index.js",
  "types": "./out/src/index.d.ts",
  "files": [
    "out/src",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jfrz38/clean-architecture-highlighter.git",
    "directory": "packages/eslint-plugin"
  },
  "homepage": "https://github.com/jfrz38/clean-architecture-highlighter/tree/main/packages/eslint-plugin#readme",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "clean-architecture",
    "architecture",
    "dependency-rule",
    "static-analysis",
    "typescript",
    "javascript"
  ],
  "packageManager": "pnpm@11.1.3",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "compile": "tsc -b ./",
    "clean:compile": "rimraf out tsconfig.tsbuildinfo && tsc -b ./",
    "lint": "eslint src test",
    "test": "pnpm run compile && mocha \"out/test/**/*.test.js\" --ui tdd --timeout 10000",
    "clean:tests": "rimraf out && pnpm run test"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "devDependencies": {
    "@jfrz38/clean-architecture-highlighter-core": "workspace:*",
    "@types/node": "25.x",
    "eslint": "10.4.0",
    "typescript-eslint": "8.60.0"
  }
}
