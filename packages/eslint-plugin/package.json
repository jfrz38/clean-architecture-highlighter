{
  "name": "@jfrz38/eslint-plugin-clean-architecture-highlighter",
  "version": "0.1.1",
  "description": "ESLint plugin for Clean Architecture dependency boundary checks.",
  "author": "José F. Ruiz <jrz899@inlumine.ual.es>",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./out/src/index.d.ts",
  "files": [
    "dist",
    "out/src/**/*.d.ts",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jfrz38/clean-architecture-highlighter.git",
    "directory": "packages/eslint-plugin"
  },
  "homepage": "https://github.com/jfrz38/clean-architecture-highlighter/tree/main/packages/eslint-plugin#readme",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "clean-architecture",
    "architecture",
    "dependency-rule",
    "static-analysis",
    "typescript",
    "javascript"
  ],
  "packageManager": "pnpm@11.1.3",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "compile": "tsc -b ./",
    "clean:compile": "rimraf out dist tsconfig.tsbuildinfo && tsc -b ./",
    "bundle": "node scripts/bundle.cjs",
    "package": "pnpm run clean:compile && pnpm run bundle",
    "prepublishOnly": "pnpm run package",
    "lint": "eslint src test",
    "test": "pnpm run compile && mocha \"out/test/**/*.test.js\" --ui tdd --timeout 10000",
    "clean:tests": "rimraf out && pnpm run test"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "devDependencies": {
    "@jfrz38/clean-architecture-highlighter-core": "workspace:*",
    "@types/node": "24.x",
    "eslint": "10.8.0",
    "typescript-eslint": "8.65.0"
  }
}
